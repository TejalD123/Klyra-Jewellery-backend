# ==========================
# SERVER
# ==========================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================
# DATABASE
# ==========================
MONGO_URI=
# or a MongoDB Atlas URI

# ==========================
# JWT (access + refresh tokens)
# ==========================
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# ==========================
# CLOUDINARY
# ==========================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================
# FIREBASE
# ==========================
# Option 1: place a serviceAccountKey.json file in src/config/ (never commit it)
# Option 2: paste the full JSON as a single-line string here
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================
# REDIS
# ==========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================
# RAZORPAY
# ==========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==========================
# EMAIL (OTP delivery via SMTP / Nodemailer)
# ==========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Klyra Jewellery" <no-reply@klyra.com>

# ==========================
# SMS (OTP delivery via Twilio)
# ==========================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================
# OTP
# ==========================
OTP_EXPIRY_MINUTES=5
